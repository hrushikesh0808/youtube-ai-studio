APP_NAME=YouTube AI Studio
APP_VERSION=0.1.0

OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=gemma3:4b
CODER_MODEL=qwen2.5-coder

LOG_LEVEL=INFO

OUTPUT_DIR=output
DATA_DIR=data

DEBUG=True

NARRATION_WPM=150
TARGET_MIN_SECONDS=120
TARGET_MAX_SECONDS=180

SHOT_TARGET_SECONDS=8
SHOT_MIN_COUNT=15
SHOT_MAX_COUNT=24

ART_STYLE=painterly anime style, soft cinematic lighting, rich detailed backgrounds, muted moody colour palette
BIBLE_MAX_ATTEMPTS=3
SHOT_DESIGN_MAX_ATTEMPTS=3

IMAGE_PROMPT_MAX_CHARS=900
IMAGE_PROVIDER=cloudflare
IMAGE_STEPS=4
IMAGE_CANDIDATES=2
IMAGE_CROP_BIAS=0.5
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

# Cloudflare Workers AI: put the real values only in .env, never in this file.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Pictures made with reference pictures (FLUX.2): size and where the approved references are kept
IMAGE_WIDTH=1344
IMAGE_HEIGHT=768
REFERENCE_DIR=output/references
SCENE_STYLE=Vivid colourful anime film illustration, painterly, clean smooth lines, sharp clean detail, no grain, rich saturated colours
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
